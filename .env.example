# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# ===== 금융시장 데이터 소스 설정 (선택) =====
# Stooq / Yahoo Finance / OECD 는 무료·키 불필요로 기본 사용 가능
# Alpha Vantage: 무료 발급 https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
# FRED 미국 연준 거시경제 데이터: 무료 발급 https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here
# 한국은행 ECOS 거시 통계: 무료 발급 https://ecos.bok.or.kr/api/
ECOS_API_KEY=your_ecos_api_key_here
# 시장 시드 텍스트 생성 시 기본으로 가져올 최근 거래일 수
MARKET_DATA_DEFAULT_LOOKBACK=60